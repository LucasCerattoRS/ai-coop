{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coop.invalid/schemas/task.schema.json",
  "title": "AI Coop Task",
  "description": "Estado autorizado de uma tarefa. Escrito apenas pelo coordenador humano.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "state",
    "assigned_by",
    "created_at",
    "updated_at",
    "scope",
    "acceptance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^AIC-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "state": {
      "enum": ["NEW","ASSIGNED","IN_PROGRESS","HANDED_OFF","UNDER_REVIEW","CHANGES_REQUESTED","ACCEPTED","CLOSED","CANCELLED"]
    },
    "owner": {"type": ["string","null"], "enum": ["claude","codex",null]},
    "role": {"enum": ["implement","review"]},
    "assigned_by": {"const": "human"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "branch": {"type": ["string","null"], "minLength": 1},
    "worktree": {"type": ["string","null"], "minLength": 1},
    "base_commit": {"type": ["string","null"], "pattern": "^[0-9a-f]{40}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths"],
      "properties": {
        "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "handoffs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string"}
  }
}
