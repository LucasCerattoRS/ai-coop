#!/usr/bin/env bash
# pre-merge-commit nao roda em fast-forward; a transacao de refs cobre main.
[[ $1 == prepared && ${AI_COOP_HUMAN:-} != 1 ]] || exit 0
while read -r _old _new ref; do
  if [[ $ref == refs/heads/main ]]; then
    printf '%s\n' 'ai-coop: somente o coordenador humano pode atualizar main (AI_COOP_HUMAN=1).' >&2
    exit 1
  fi
done
